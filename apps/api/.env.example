# Database
DATABASE_URL=postgresql+asyncpg://pockiva:pockiva_dev@localhost:5432/pockiva

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# App
APP_ENV=local
APP_NAME=Pockiva
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sentry (optional)
SENTRY_DSN=

# Africa's Talking (SMS)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=Pockiva

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/mpesa

# Web Push (VAPID) — generate with: python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key, v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=admin@pockiva.com

# SMTP (for email OTP, notifications) — use Mailgun, SendGrid, AWS SES, etc.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@pockiva.com
SMTP_FROM_NAME=Pockiva

# Admin SMS alerts
ADMIN_ALERT_PHONE=

# Comma-separated IDs of explicitly authorised admin users (empty disables admin API access)
ADMIN_USER_IDS=
